# =====================================================================
# POLYMARKET 5-MINUTE BOT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual private key and address
# =====================================================================

# 1. Mandatory Safety Double-Gate for Live Real-Money Trading
LIVE_CONFIRM=YES_I_UNDERSTAND

# 2. Polygon Wallet Configuration (MetaMask / EOA Private Key)
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
POLY_FUNDER_ADDRESS=0xYOUR_PUBLIC_WALLET_ADDRESS_HERE
POLY_SIG_TYPE=0                            # 0 = EOA / MetaMask, 1 = Email / Magic, 2 = Gnosis Safe

# 3. Polymarket CLOB API Credentials (Auto-derived or generated from Polymarket Settings)
POLY_API_KEY=YOUR_API_KEY_UUID
POLY_SECRET=YOUR_BASE64_SECRET
POLY_PASSPHRASE=YOUR_API_PASSPHRASE

# 4. Polygon Mainnet RPC Endpoint
POLYGON_RPC_URL=https://polygon-rpc.com

# 5. Risk & Execution Limits
MICRO_STAKE_CAP_USD=1.00                   # Initial safety ramp limit ($1.00)
DAILY_LOSS_LIMIT_USD=30.00
KILL_SWITCH_FILE=STOP

# 6. Dashboard Configuration
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_ENABLED=true

# 7. Option B: Prime-Hours Fortress & Pure Early Exit Safeguards
PRIME_HOURS_ONLY=true
ENABLE_REVERSALS=false
PRICE_CEILING=0.910

